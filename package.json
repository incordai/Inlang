{
  "name": "az",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/overlay/tsconfig.json",
    "test": "node --experimental-strip-types --test packages/core/test/*.test.ts packages/theme/test/*.test.ts packages/words/test/*.test.ts packages/target-web/test/*.test.ts packages/cli/test/*.test.ts packages/overlay/test/*.test.ts",
    "verify": "pnpm typecheck && pnpm test",
    "verify:build": "node scripts/verify-build.mjs",
    "coverage": "node scripts/word-coverage.mjs",
    "test:visual": "node scripts/visual.mjs",
    "gate": "node scripts/gate.mjs",
    "thumbnails": "node scripts/thumbnails.mjs",
    "lint": "node packages/cli/bin/az.js lint packages/words"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@types/node": "26.2.0",
    "playwright": "1.63.0",
    "typescript": "7.0.2"
  }
}
