{
  "name": "az",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.2",
  "imports": {
    "#tokenizer/*": "gpt-tokenizer/encoding/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --noEmit -p packages/overlay/tsconfig.json && tsc --noEmit -p packages/auth-runtime/tsconfig.json && tsc --noEmit -p packages/scene-runtime/tsconfig.json",
    "test": "node --experimental-strip-types --test packages/core/test/*.test.ts packages/theme/test/*.test.ts packages/words/test/*.test.ts packages/target-web/test/*.test.ts packages/cli/test/*.test.ts packages/overlay/test/*.test.ts packages/auth-runtime/test/*.test.ts packages/scene-runtime/test/*.test.ts packages/backend/test/*.test.ts packages/mcp/test/*.test.ts scripts/lib/*.test.mjs",
    "verify": "pnpm typecheck && pnpm test",
    "verify:build": "node scripts/verify-build.mjs",
    "coverage": "node scripts/word-coverage.mjs",
    "test:visual": "node scripts/visual.mjs",
    "test:auth": "node scripts/auth-e2e.mjs",
    "test:cloud-auth": "node scripts/cloud-auth-e2e.mjs",
    "test:dev": "node scripts/dev-e2e.mjs && node scripts/dev-preview-e2e.mjs && node scripts/add-chat-e2e.mjs",
    "test:3d": "node scripts/test-3d.mjs",
    "test:lighthouse": "node scripts/lighthouse.mjs",
    "gate": "node scripts/gate.mjs",
    "thumbnails": "node scripts/thumbnails.mjs",
    "test:palette": "node scripts/palette.mjs",
    "lint": "node packages/cli/bin/az.js lint packages/words",
    "test:backend-db": "node scripts/backend-db.mjs",
    "test:data": "node scripts/data-e2e.mjs",
    "test:chat": "node scripts/chat-e2e.mjs && node scripts/chat-public-e2e.mjs",
    "bench:tokens": "node scripts/token-benchmark.mjs",
    "scan:secrets": "gitleaks git --redact --no-banner . && gitleaks dir --redact --no-banner .",
    "scan:deps": "osv-scanner scan source -L pnpm-lock.yaml -L spike-m0/pnpm-lock.yaml",
    "scan:actions": "actionlint"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@protomaps/basemaps": "5.7.2",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "gpt-tokenizer": "4.0.0",
    "lighthouse": "13.5.0",
    "maplibre-gl": "6.13.0",
    "mysql2": "3.24.5",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "playwright": "1.64.0",
    "pmtiles": "4.5.0",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "typescript": "7.0.2"
  }
}
