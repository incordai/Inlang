{
  "name": "text",
  "version": "1.0.0",
  "kind": "block",
  "variants": [
    "prose",
    "centered",
    "columns"
  ],
  "modifiers": [
    "reveal"
  ],
  "props": {
    "title": {
      "type": "string",
      "required": false,
      "maxWords": 10
    },
    "body": {
      "type": "markdown",
      "required": true,
      "ext": [
        ".md"
      ],
      "maxBytes": 262144,
      "maxWords": 800
    }
  },
  "slots": {
    "cta": {
      "max": 1
    },
    "alt": {
      "max": 1
    }
  },
  "requires": {},
  "themeReads": [
    "color.text",
    "color.muted",
    "color.accent",
    "color.border",
    "color.focus",
    "color.surface-alt",
    "space.*",
    "type.*",
    "motion.slow",
    "motion.reduced",
    "motion.ease.emphasis",
    "size.measure-body",
    "size.measure-display",
    "breakpoint.sm"
  ],
  "deps": {
    "micromark": "4.0.2",
    "micromark-extension-gfm": "3.0.0"
  },
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2200",
      "kind": "when",
      "severity": "warning",
      "message": "'reveal' delays the one block people came to read — drop it, or use 'centered'",
      "when": {
        "variant": [
          "prose"
        ],
        "modifier": "reveal"
      }
    },
    {
      "code": "AZ2201",
      "kind": "valuePattern",
      "severity": "warning",
      "message": "inline body is one paragraph — move it to a .md file",
      "prop": "body",
      "pattern": "\\n\\s*\\n"
    },
    {
      "code": "AZ2202",
      "kind": "propWords",
      "severity": "warning",
      "message": "'centered' is for one statement, this is {n} words — use 'prose'",
      "prop": "body",
      "atLeast": 61,
      "when": {
        "variant": [
          "centered"
        ]
      }
    },
    {
      "code": "AZ2203",
      "kind": "propWords",
      "severity": "warning",
      "message": "{n} words is too short to split — use 'prose'",
      "prop": "body",
      "atMost": 119,
      "when": {
        "variant": [
          "columns"
        ]
      }
    },
    {
      "code": "AZ2204",
      "kind": "propWords",
      "severity": "warning",
      "message": "{n} words makes columns taller than the screen — use 'prose'",
      "prop": "body",
      "atLeast": 301,
      "when": {
        "variant": [
          "columns"
        ]
      }
    }
  ]
}
