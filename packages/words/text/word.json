{
  "name": "text",
  "version": "1.0.0",
  "kind": "block",
  "description": "Section of written copy from a string or .md file",
  "descriptions": {
    "variants": {
      "prose": "Body text at reading measure (default)",
      "centered": "One short centred statement",
      "columns": "Two text columns; one below 1024px"
    },
    "modifiers": {
      "reveal": "Rises into view once when scrolled to"
    }
  },
  "variants": [
    "prose",
    "centered",
    "columns"
  ],
  "modifiers": [
    "reveal"
  ],
  "props": {
    "title": {
      "type": "string",
      "required": false,
      "maxWords": 10,
      "description": "Section heading (h2)"
    },
    "body": {
      "type": "markdown",
      "required": true,
      "ext": [
        ".md"
      ],
      "maxBytes": 262144,
      "maxWords": 800,
      "description": "Inline text, or a .md file rendered at build"
    }
  },
  "slots": {
    "cta": {
      "max": 1,
      "description": "Primary button under the text",
      "line": [
        "label",
        "destination"
      ]
    },
    "alt": {
      "max": 1,
      "description": "Secondary action beside the primary",
      "line": [
        "label",
        "destination"
      ]
    }
  },
  "requires": {},
  "themeReads": [
    "color.text",
    "color.veil",
    "size.gutter-sm",
    "size.measure-body",
    "size.measure-display",
    "space.16",
    "space.24",
    "space.48",
    "space.96",
    "type.display",
    "type.leading-body",
    "type.leading-tight",
    "type.size.2xl",
    "type.size.base",
    "type.weight-display"
  ],
  "deps": {
    "mdast-util-from-markdown": "2.0.3",
    "mdast-util-gfm-strikethrough": "2.0.0",
    "mdast-util-gfm-table": "2.0.0",
    "micromark": "4.0.2",
    "micromark-extension-gfm-strikethrough": "2.1.0",
    "micromark-extension-gfm-table": "2.1.2"
  },
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2200",
      "kind": "when",
      "severity": "warning",
      "message": "'reveal' delays the one block people came to read — drop it, or use 'centered'",
      "when": {
        "variant": [
          "prose"
        ],
        "modifier": "reveal"
      }
    },
    {
      "code": "AZ2201",
      "kind": "valuePattern",
      "severity": "warning",
      "message": "inline body is one paragraph — move it to a .md file",
      "prop": "body",
      "pattern": "\\n\\s*\\n"
    },
    {
      "code": "AZ2202",
      "kind": "propWords",
      "severity": "warning",
      "message": "'centered' is for one statement, this is {n} words — use 'prose'",
      "prop": "body",
      "atLeast": 61,
      "when": {
        "variant": [
          "centered"
        ]
      }
    },
    {
      "code": "AZ2203",
      "kind": "propWords",
      "severity": "warning",
      "message": "{n} words is too short to split — use 'prose'",
      "prop": "body",
      "atMost": 119,
      "when": {
        "variant": [
          "columns"
        ]
      }
    },
    {
      "code": "AZ2204",
      "kind": "propWords",
      "severity": "warning",
      "message": "{n} words makes columns taller than the screen — use 'prose'",
      "prop": "body",
      "atLeast": 301,
      "when": {
        "variant": [
          "columns"
        ]
      }
    }
  ]
}
