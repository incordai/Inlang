{
  "name": "auth",
  "version": "1.0.0",
  "kind": "block",
  "variants": [
    "login",
    "signup",
    "reset"
  ],
  "modifiers": [
    "glass"
  ],
  "props": {
    "adapter": {
      "type": "enum",
      "values": [
        "hosted",
        "session",
        "azbackend",
        "custom"
      ],
      "required": true,
      "scope": "site"
    },
    "profile": {
      "type": "enum",
      "values": [
        "standard",
        "token-endpoint"
      ],
      "default": "standard",
      "scope": "site"
    },
    "title": {
      "type": "string",
      "maxWords": 8
    },
    "sub": {
      "type": "string",
      "maxWords": 20
    },
    "methods": {
      "type": "list",
      "of": "enum",
      "values": [
        "password",
        "link",
        "oauth"
      ],
      "max": 3,
      "default": [
        "password"
      ]
    },
    "redirect": {
      "type": "route"
    },
    "terms": {
      "type": "route"
    },
    "impl": {
      "type": "path",
      "ext": [
        ".ts",
        ".tsx"
      ],
      "scope": "site"
    },
    "protect": {
      "type": "list",
      "of": "route",
      "scope": "site"
    }
  },
  "slots": {
    "alt": {
      "max": 2
    }
  },
  "requires": {
    "signup": [
      "terms"
    ]
  },
  "requiresWhen": {
    "adapter": {
      "custom": [
        "impl"
      ]
    }
  },
  "themeReads": [
    "color.surface",
    "color.text",
    "color.muted",
    "color.border",
    "color.accent",
    "color.danger",
    "space.*",
    "type.body",
    "type.size.sm",
    "radius.md"
  ],
  "deps": {},
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": []
  },
  "checks": [
    {
      "code": "AZ2000",
      "kind": "when",
      "severity": "error",
      "message": "no form named — pick one of 'login', 'signup', 'reset'",
      "when": {
        "noVariant": true,
        "inPage": true
      }
    },
    {
      "code": "AZ2001",
      "kind": "perPage",
      "severity": "error",
      "message": "only one form per page (it owns the <h1>)",
      "atMost": 1
    },
    {
      "code": "AZ2002",
      "kind": "count",
      "severity": "warning",
      "message": "'login' offers no way to sign up or recover — add: alt \"Create an account\" /signup",
      "slots": [
        "alt"
      ],
      "atMost": 0,
      "when": {
        "variant": [
          "login"
        ],
        "inPage": true
      }
    },
    {
      "code": "AZ2003",
      "kind": "when",
      "severity": "warning",
      "message": "'glass' reduces contrast on credential fields — use the plain surface",
      "when": {
        "modifier": "glass"
      }
    },
    {
      "code": "AZ2004",
      "kind": "siteNeeds",
      "severity": "warning",
      "message": "a protected route has nowhere to send signed-out users — add a page with 'auth login'",
      "when": {
        "prop": "protect"
      },
      "needs": {
        "variant": [
          "login"
        ]
      }
    },
    {
      "code": "AZ2005",
      "kind": "pageWhen",
      "severity": "error",
      "message": "'methods oauth' needs adapter azbackend, session or hosted — their server runs the provider sign-in",
      "when": {
        "prop": "methods",
        "includes": "oauth",
        "also": {
          "prop": "adapter",
          "notIn": [
            "azbackend",
            "session",
            "hosted"
          ]
        }
      }
    },
    {
      "code": "AZ2006",
      "kind": "pageWhen",
      "severity": "error",
      "message": "'methods oauth' with adapter hosted needs profile token-endpoint — the standard hosted protocol has no provider sign-in",
      "when": {
        "prop": "methods",
        "includes": "oauth",
        "also": {
          "prop": "adapter",
          "value": "hosted",
          "also": {
            "prop": "profile",
            "notIn": [
              "token-endpoint"
            ]
          }
        }
      }
    }
  ]
}
