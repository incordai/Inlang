{
  "name": "auth",
  "version": "1.0.0",
  "kind": "block",
  "description": "Sign-in, sign-up or password-reset form on its own page",
  "descriptions": {
    "variants": {
      "login": "Email/password sign-in for returning users",
      "signup": "Account creation form with a terms link",
      "reset": "Request a reset link, then set a new password"
    },
    "modifiers": {
      "glass": "Blurred form card (warned: blur near credentials)"
    }
  },
  "variants": [
    "login",
    "signup",
    "reset"
  ],
  "modifiers": [
    "glass"
  ],
  "props": {
    "adapter": {
      "type": "enum",
      "values": [
        "hosted",
        "session",
        "azbackend",
        "custom"
      ],
      "required": true,
      "scope": "site",
      "description": "Which auth service handles the form (site level)",
      "valueDescriptions": {
        "hosted": "A managed auth provider, public key only",
        "session": "Same-origin cookie session routes on your server",
        "azbackend": "The az backend protocol (built-in or your own)",
        "custom": "Your own adapter module, set with impl"
      }
    },
    "profile": {
      "type": "enum",
      "values": [
        "standard",
        "token-endpoint"
      ],
      "default": "standard",
      "scope": "site",
      "description": "Protocol the hosted adapter speaks (site level)",
      "valueDescriptions": {
        "standard": "The default hosted protocol",
        "token-endpoint": "Token-endpoint auth server protocol, with social"
      }
    },
    "title": {
      "type": "string",
      "maxWords": 8,
      "description": "Form heading, the page h1; defaults per flow"
    },
    "sub": {
      "type": "string",
      "maxWords": 20,
      "description": "Line of text under the heading"
    },
    "methods": {
      "type": "list",
      "of": "enum",
      "values": [
        "password",
        "link",
        "oauth"
      ],
      "max": 3,
      "default": [
        "password"
      ],
      "description": "Sign-in methods offered: password, link, oauth",
      "valueDescriptions": {
        "password": "Email and password fields",
        "link": "Passwordless emailed sign-in link",
        "oauth": "Continue-with buttons for social providers"
      }
    },
    "redirect": {
      "type": "route",
      "description": "Page to open after a successful sign-in"
    },
    "terms": {
      "type": "route",
      "description": "Terms page linked from the signup form"
    },
    "impl": {
      "type": "path",
      "ext": [
        ".ts",
        ".tsx"
      ],
      "scope": "site",
      "description": "Path to the custom adapter module (site level)"
    },
    "protect": {
      "type": "list",
      "of": "route",
      "scope": "site",
      "description": "Routes that require a signed-in user (site level)"
    }
  },
  "slots": {
    "alt": {
      "max": 2,
      "description": "Link to a sibling flow, e.g. sign up or reset",
      "line": [
        "label",
        "destination"
      ]
    }
  },
  "requires": {
    "signup": [
      "terms"
    ]
  },
  "requiresWhen": {
    "adapter": {
      "custom": [
        "impl"
      ]
    }
  },
  "themeReads": [
    "color.bg",
    "color.border",
    "color.danger",
    "color.muted",
    "color.surface",
    "color.text",
    "radius.md",
    "radius.sm",
    "size.gutter-sm",
    "size.measure-body",
    "size.measure-display",
    "size.tap",
    "space.4",
    "space.8",
    "space.12",
    "space.16",
    "space.24",
    "space.32",
    "space.96",
    "type.display",
    "type.leading-body",
    "type.leading-tight",
    "type.size.2xl",
    "type.size.base",
    "type.size.sm",
    "type.weight-bold",
    "type.weight-display"
  ],
  "deps": {},
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": []
  },
  "checks": [
    {
      "code": "AZ2000",
      "kind": "when",
      "severity": "error",
      "message": "no form named — pick one of 'login', 'signup', 'reset'",
      "when": {
        "noVariant": true,
        "inPage": true
      }
    },
    {
      "code": "AZ2001",
      "kind": "perPage",
      "severity": "error",
      "message": "only one form per page (it owns the <h1>)",
      "atMost": 1
    },
    {
      "code": "AZ2002",
      "kind": "count",
      "severity": "warning",
      "message": "'login' offers no way to sign up or recover — add: alt \"Create an account\" /signup",
      "slots": [
        "alt"
      ],
      "atMost": 0,
      "when": {
        "variant": [
          "login"
        ],
        "inPage": true
      }
    },
    {
      "code": "AZ2003",
      "kind": "when",
      "severity": "warning",
      "message": "'glass' reduces contrast on credential fields — use the plain surface",
      "when": {
        "modifier": "glass"
      }
    },
    {
      "code": "AZ2004",
      "kind": "siteNeeds",
      "severity": "warning",
      "message": "a protected route has nowhere to send signed-out users — add a page with 'auth login'",
      "when": {
        "prop": "protect"
      },
      "needs": {
        "variant": [
          "login"
        ]
      }
    },
    {
      "code": "AZ2005",
      "kind": "pageWhen",
      "severity": "error",
      "message": "'methods oauth' needs adapter azbackend, session or hosted — their server runs the provider sign-in",
      "when": {
        "prop": "methods",
        "includes": "oauth",
        "also": {
          "prop": "adapter",
          "notIn": [
            "azbackend",
            "session",
            "hosted"
          ]
        }
      }
    },
    {
      "code": "AZ2006",
      "kind": "pageWhen",
      "severity": "error",
      "message": "'methods oauth' with adapter hosted needs profile token-endpoint — the standard hosted protocol has no provider sign-in",
      "when": {
        "prop": "methods",
        "includes": "oauth",
        "also": {
          "prop": "adapter",
          "value": "hosted",
          "also": {
            "prop": "profile",
            "notIn": [
              "token-endpoint"
            ]
          }
        }
      }
    }
  ]
}
