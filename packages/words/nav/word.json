{
  "name": "nav",
  "version": "1.0.0",
  "kind": "block",
  "variants": [
    "bar",
    "center",
    "split",
    "minimal",
    "side",
    "mega",
    "none"
  ],
  "modifiers": [
    "sticky",
    "hide",
    "shrink",
    "glass",
    "solid"
  ],
  "props": {
    "logo": {
      "type": "path",
      "ext": [
        ".svg",
        ".png",
        ".webp"
      ]
    },
    "inverse": {
      "type": "path",
      "ext": [
        ".svg",
        ".png",
        ".webp"
      ]
    },
    "mobile": {
      "type": "enum",
      "values": [
        "drawer",
        "sheet",
        "full"
      ],
      "default": "drawer"
    }
  },
  "children": [
    "link",
    "group",
    "cta"
  ],
  "limits": {
    "link": {
      "max": 7
    },
    "cta": {
      "max": 1
    },
    "depth": 2
  },
  "themeReads": [
    "color.bg",
    "color.surface",
    "color.text",
    "color.muted",
    "color.accent",
    "color.accent-contrast",
    "color.scrim",
    "color.on-scrim",
    "space.*",
    "type.body",
    "motion.*",
    "size.ring",
    "layer.sticky",
    "layer.dropdown",
    "layer.scrim",
    "layer.skip",
    "size.nav",
    "size.nav-shrink",
    "size.tap"
  ],
  "deps": {
    "@floating-ui/react": "0.26.28"
  },
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "recommends": {
    "solid": [
      "inverse"
    ]
  },
  "checks": [
    {
      "code": "AZ2140",
      "kind": "count",
      "severity": "warning",
      "message": "{n} links. Max 7 — group them or simplify the IA",
      "slots": [
        "link",
        "group"
      ],
      "atLeast": 8
    },
    {
      "code": "AZ2141",
      "kind": "count",
      "severity": "error",
      "message": "'mega' needs 2+ groups. Use a plain dropdown",
      "slots": [
        "group"
      ],
      "atMost": 1,
      "when": {
        "variant": [
          "mega"
        ]
      }
    },
    {
      "code": "AZ2142",
      "kind": "count",
      "severity": "error",
      "message": "{n} CTAs. Nav gets one",
      "slots": [
        "cta"
      ],
      "atLeast": 2
    },
    {
      "code": "AZ2143",
      "kind": "childLabelWords",
      "severity": "warning",
      "message": "\"{label}\" — nav labels should be 1–2 words",
      "slots": [
        "link",
        "group"
      ],
      "atMost": 2
    }
  ]
}
