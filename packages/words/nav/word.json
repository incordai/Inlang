{
  "name": "nav",
  "version": "1.0.0",
  "kind": "block",
  "description": "Site navigation bar with links, groups and a CTA",
  "descriptions": {
    "variants": {
      "bar": "Logo left, links right (default)",
      "center": "Logo centred between links",
      "split": "Logo, links and a protected CTA in three zones",
      "minimal": "Menu button at every screen size",
      "side": "Vertical column beside the page content",
      "mega": "Group dropdowns span the full width",
      "none": "No nav on this page (page level)"
    },
    "modifiers": {
      "sticky": "Stays pinned to the top while scrolling",
      "hide": "Hides scrolling down, returns scrolling up",
      "shrink": "Gets shorter after scrolling past the top",
      "glass": "Blurred veil behind the bar; solid where unsupported",
      "solid": "Transparent over the hero, solid after scroll"
    },
    "children": {
      "link": "Link: label then destination",
      "group": "Labelled dropdown of links",
      "cta": "Button in the nav, kept in the bar on phones"
    }
  },
  "variants": [
    "bar",
    "center",
    "split",
    "minimal",
    "side",
    "mega",
    "none"
  ],
  "modifiers": [
    "sticky",
    "hide",
    "shrink",
    "glass",
    "solid"
  ],
  "props": {
    "logo": {
      "type": "path",
      "ext": [
        ".svg",
        ".png",
        ".webp"
      ],
      "description": "Logo image; the link is named by the site"
    },
    "inverse": {
      "type": "path",
      "ext": [
        ".svg",
        ".png",
        ".webp"
      ],
      "description": "Light logo shown while the solid nav is clear"
    },
    "mobile": {
      "type": "enum",
      "values": [
        "drawer",
        "sheet",
        "full"
      ],
      "default": "drawer",
      "description": "How the menu opens on phones",
      "valueDescriptions": {
        "drawer": "Panel slides in from the side (default)",
        "sheet": "Menu rises from the bottom; drag down to close",
        "full": "Menu covers the whole screen and fades in"
      }
    }
  },
  "children": [
    "link",
    "group",
    "cta"
  ],
  "limits": {
    "link": {
      "max": 7
    },
    "cta": {
      "max": 1
    },
    "depth": 2
  },
  "themeReads": [
    "color.bg",
    "color.border-strong",
    "color.focus",
    "color.muted",
    "color.scrim",
    "color.surface",
    "color.text",
    "layer.skip",
    "layer.sticky",
    "motion.ease",
    "motion.fast",
    "motion.normal",
    "radius.full",
    "shadow.sm",
    "size.gutter-lg",
    "size.gutter-sm",
    "size.nav",
    "size.nav-shrink",
    "size.nav-side",
    "size.ring",
    "size.ring-offset",
    "size.tap",
    "space.4",
    "space.8",
    "space.12",
    "space.16",
    "space.24",
    "space.32",
    "type.body",
    "type.size.sm"
  ],
  "deps": {},
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "recommends": {
    "solid": [
      "inverse"
    ]
  },
  "checks": [
    {
      "code": "AZ2140",
      "kind": "count",
      "severity": "warning",
      "message": "{n} links. Max 7 — group them or simplify the IA",
      "slots": [
        "link",
        "group"
      ],
      "atLeast": 8
    },
    {
      "code": "AZ2141",
      "kind": "count",
      "severity": "error",
      "message": "'mega' needs 2+ groups. Use a plain dropdown",
      "slots": [
        "group"
      ],
      "atMost": 1,
      "when": {
        "variant": [
          "mega"
        ]
      }
    },
    {
      "code": "AZ2142",
      "kind": "count",
      "severity": "error",
      "message": "{n} CTAs. Nav gets one",
      "slots": [
        "cta"
      ],
      "atLeast": 2
    },
    {
      "code": "AZ2143",
      "kind": "childLabelWords",
      "severity": "warning",
      "message": "\"{label}\" — nav labels should be 1–2 words",
      "slots": [
        "link",
        "group"
      ],
      "atMost": 2
    }
  ]
}
