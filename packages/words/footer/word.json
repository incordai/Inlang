{
  "name": "footer",
  "version": "1.0.0",
  "kind": "block",
  "variants": [
    "minimal",
    "columns",
    "mega"
  ],
  "modifiers": [
    "glass"
  ],
  "props": {
    "logo": {
      "type": "path",
      "ext": [
        ".svg",
        ".png"
      ],
      "maxBytes": 262144
    },
    "tagline": {
      "type": "string",
      "maxWords": 14
    },
    "copyright": {
      "type": "string",
      "maxWords": 8
    },
    "since": {
      "type": "int",
      "min": 1990,
      "max": 2100
    },
    "year": {
      "type": "enum",
      "values": [
        "none",
        "since",
        "dynamic"
      ],
      "default": "none"
    }
  },
  "slots": {
    "group": {
      "max": 5,
      "slots": {
        "link": {
          "max": 12
        }
      }
    },
    "link": {
      "max": 24
    },
    "social": {
      "max": 6
    },
    "legal": {
      "max": 4
    }
  },
  "requires": {
    "columns": [
      "group"
    ],
    "mega": [
      "group"
    ]
  },
  "themeReads": [
    "color.surface",
    "color.muted",
    "color.border",
    "color.text",
    "space.*",
    "type.body",
    "type.size.sm",
    "radius.sm"
  ],
  "deps": {},
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chrome-latest",
      "safari-latest",
      "firefox-latest",
      "ios-17"
    ],
    "with": [
      "nav",
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2080",
      "kind": "perPage",
      "severity": "error",
      "message": "only one per page (it owns the contentinfo landmark)",
      "atMost": 1
    },
    {
      "code": "AZ2081",
      "kind": "childRoute",
      "severity": "error",
      "message": "'{value}' is not a page in this site — add it or fix the link",
      "slots": [
        "link",
        "legal"
      ]
    },
    {
      "code": "AZ2082",
      "kind": "count",
      "severity": "warning",
      "message": "'mega' has {n} groups — use 'columns'",
      "slots": [
        "group"
      ],
      "atMost": 3,
      "when": {
        "variant": [
          "mega"
        ]
      }
    },
    {
      "code": "AZ2083",
      "kind": "count",
      "severity": "warning",
      "message": "{n} links, max is 24 — this is a sitemap, move it to a page",
      "slots": [
        "link"
      ],
      "atLeast": 25
    },
    {
      "code": "AZ2084",
      "kind": "childLabelWords",
      "severity": "warning",
      "message": "'{label}' — footer labels should be 1–3 words",
      "slots": [
        "link",
        "legal",
        "social"
      ],
      "atMost": 3
    }
  ],
  "requiresWhen": {
    "year": {
      "dynamic": [
        "since"
      ]
    }
  }
}
