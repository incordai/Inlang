{
  "name": "footer",
  "version": "1.0.0",
  "kind": "block",
  "description": "Site footer: links, legal row and copyright",
  "descriptions": {
    "variants": {
      "minimal": "Logo, tagline and legal row only",
      "columns": "Two to five link groups in columns",
      "mega": "Many groups; accordions on phones"
    },
    "modifiers": {
      "glass": "Blurred translucent surface (not rendered yet)"
    }
  },
  "variants": [
    "minimal",
    "columns",
    "mega"
  ],
  "modifiers": [
    "glass"
  ],
  "props": {
    "logo": {
      "type": "path",
      "ext": [
        ".svg",
        ".png"
      ],
      "maxBytes": 262144,
      "description": "Logo image; the link is named by the site"
    },
    "tagline": {
      "type": "string",
      "maxWords": 14,
      "description": "Short line beside the logo"
    },
    "copyright": {
      "type": "string",
      "maxWords": 8,
      "description": "Name shown after the copyright sign"
    },
    "since": {
      "type": "int",
      "min": 1990,
      "max": 2100,
      "description": "Founding year, used by year since/dynamic"
    },
    "year": {
      "type": "enum",
      "values": [
        "none",
        "since",
        "dynamic"
      ],
      "default": "none",
      "description": "Which year the copyright line shows",
      "valueDescriptions": {
        "none": "No year in the copyright line",
        "since": "The since year, as written",
        "dynamic": "Since year, updated to the current year in page"
      }
    }
  },
  "slots": {
    "group": {
      "max": 5,
      "slots": {
        "link": {
          "max": 12,
          "description": "Link inside a group"
        }
      },
      "description": "Titled group of links (a column)"
    },
    "link": {
      "max": 24,
      "description": "Link outside any group"
    },
    "social": {
      "max": 6,
      "description": "Social profile link; external ones open a new tab"
    },
    "legal": {
      "max": 4,
      "description": "Legal link in the copyright row"
    }
  },
  "requires": {
    "columns": [
      "group"
    ],
    "mega": [
      "group"
    ]
  },
  "themeReads": [
    "color.surface",
    "color.muted",
    "color.border",
    "color.text",
    "space.*",
    "type.body",
    "type.size.sm",
    "radius.sm"
  ],
  "deps": {},
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2080",
      "kind": "perPage",
      "severity": "error",
      "message": "only one per page (it owns the contentinfo landmark)",
      "atMost": 1
    },
    {
      "code": "AZ2081",
      "kind": "childRoute",
      "severity": "error",
      "message": "'{value}' is not a page in this site — add it or fix the link",
      "slots": [
        "link",
        "legal"
      ]
    },
    {
      "code": "AZ2082",
      "kind": "count",
      "severity": "warning",
      "message": "'mega' has {n} groups — use 'columns'",
      "slots": [
        "group"
      ],
      "atMost": 3,
      "when": {
        "variant": [
          "mega"
        ]
      }
    },
    {
      "code": "AZ2083",
      "kind": "count",
      "severity": "warning",
      "message": "{n} links, max is 24 — this is a sitemap, move it to a page",
      "slots": [
        "link"
      ],
      "atLeast": 25
    },
    {
      "code": "AZ2084",
      "kind": "childLabelWords",
      "severity": "warning",
      "message": "'{label}' — footer labels should be 1–3 words",
      "slots": [
        "link",
        "legal",
        "social"
      ],
      "atMost": 3
    }
  ],
  "requiresWhen": {
    "year": {
      "dynamic": [
        "since"
      ]
    }
  }
}
