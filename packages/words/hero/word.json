{
  "name": "hero",
  "version": "1.0.0",
  "kind": "block",
  "description": "Page opener: the page's only h1, text and actions",
  "descriptions": {
    "variants": {
      "center": "Centred statement; visual behind or below",
      "split": "Text beside the visual; stacks on phones",
      "full": "Text over a full-bleed visual with a scrim",
      "stack": "Text above a full-width visual",
      "minimal": "Type only, no visual"
    },
    "modifiers": {
      "3d": "Adds a 3D scene (procedural or model)",
      "scroll": "3D camera follows page scroll; needs 3d",
      "parallax": "Visual moves slower than the page on scroll",
      "glass": "Blurs the page backdrop behind the type"
    }
  },
  "variants": [
    "center",
    "split",
    "full",
    "stack",
    "minimal"
  ],
  "modifiers": [
    "3d",
    "scroll",
    "parallax",
    "glass"
  ],
  "props": {
    "eyebrow": {
      "type": "string",
      "maxWords": 6,
      "description": "Short label above the title, not a heading"
    },
    "title": {
      "type": "string",
      "required": true,
      "maxWords": 12,
      "description": "The page h1"
    },
    "sub": {
      "type": "string",
      "maxWords": 30,
      "description": "Supporting line under the title"
    },
    "model": {
      "type": "path",
      "ext": [
        ".glb"
      ],
      "maxBytes": 5242880,
      "description": "Draco .glb model for the 3D scene"
    },
    "poster": {
      "type": "path",
      "ext": [
        ".jpg",
        ".png",
        ".webp"
      ],
      "description": "Still for static tier and loading; resized at build"
    },
    "describe": {
      "type": "string",
      "maxWords": 20,
      "description": "Alt text for the poster and 3D scene"
    },
    "focus": {
      "type": "enum",
      "default": "center",
      "values": [
        "center",
        "top",
        "bottom",
        "left",
        "right"
      ],
      "description": "Which part of the poster to keep when cropping",
      "valueDescriptions": {
        "center": "Keep the centre (default)",
        "top": "Keep the top edge",
        "bottom": "Keep the bottom edge",
        "left": "Keep the left edge",
        "right": "Keep the right edge"
      }
    },
    "height": {
      "type": "enum",
      "values": [
        "compact",
        "peek",
        "tall",
        "full"
      ],
      "default": "peek",
      "description": "How much of the screen the hero fills",
      "valueDescriptions": {
        "compact": "70% of the screen; a header, not a statement",
        "peek": "85% of the screen; next section peeks (default)",
        "tall": "92% of the screen for one strong asset",
        "full": "Whole screen; hides the page below it"
      }
    }
  },
  "slots": {
    "cta": {
      "max": 2,
      "description": "Primary button, up to two"
    },
    "alt": {
      "max": 1,
      "description": "Secondary action; a text link on small phones"
    }
  },
  "requires": {
    "scroll": [
      "3d"
    ]
  },
  "recommends": {
    "3d": [
      "poster",
      "describe"
    ]
  },
  "themeReads": [
    "breakpoint.sm",
    "color.muted",
    "color.on-scrim",
    "color.scrim",
    "color.text",
    "color.veil",
    "layer.behind",
    "size.gutter-sm",
    "size.measure-body",
    "size.measure-display",
    "space.16",
    "space.24",
    "space.48",
    "space.96",
    "type.display",
    "type.leading-body",
    "type.leading-display",
    "type.size.display",
    "type.size.display-lg",
    "type.size.lg",
    "type.size.xs",
    "type.weight-display"
  ],
  "deps": {
    "three": "0.186.0"
  },
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": []
  },
  "checks": [
    {
      "code": "AZ2120",
      "kind": "count",
      "severity": "error",
      "message": "{n} CTAs. Maximum is 2 (one primary, one secondary)",
      "slots": [
        "cta",
        "alt"
      ],
      "atLeast": 3
    },
    {
      "code": "AZ2121",
      "kind": "perPage",
      "severity": "error",
      "message": "only one per page (it owns the <h1>)",
      "atMost": 1
    },
    {
      "code": "AZ2122",
      "kind": "when",
      "severity": "warning",
      "message": "'full' fills the screen and hides the page below it — 'tall' keeps the peek that earns the scroll",
      "when": {
        "prop": "height",
        "value": "full"
      }
    },
    {
      "code": "AZ2123",
      "kind": "when",
      "severity": "warning",
      "message": "'glass' on 'full' does nothing — the scrim already carries the type",
      "when": {
        "variant": [
          "full"
        ],
        "modifier": "glass"
      }
    },
    {
      "code": "AZ2124",
      "kind": "pageLacks",
      "severity": "warning",
      "message": "'glass' has nothing to blur — add a scene backdrop behind the page",
      "when": {
        "modifier": "glass",
        "notVariant": [
          "full"
        ]
      },
      "needsWord": "scene",
      "needs": {
        "variant": [
          "backdrop"
        ]
      }
    }
  ]
}
