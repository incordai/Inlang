{
  "name": "hero",
  "version": "1.0.0",
  "kind": "block",
  "variants": [
    "center",
    "split",
    "full",
    "stack",
    "minimal"
  ],
  "modifiers": [
    "3d",
    "scroll",
    "parallax",
    "glass"
  ],
  "props": {
    "eyebrow": {
      "type": "string",
      "maxWords": 6
    },
    "title": {
      "type": "string",
      "required": true,
      "maxWords": 12
    },
    "sub": {
      "type": "string",
      "maxWords": 30
    },
    "model": {
      "type": "path",
      "ext": [
        ".glb"
      ],
      "maxBytes": 5242880
    },
    "poster": {
      "type": "path",
      "ext": [
        ".jpg",
        ".png",
        ".webp"
      ]
    },
    "describe": {
      "type": "string",
      "maxWords": 20
    },
    "height": {
      "type": "enum",
      "values": [
        "compact",
        "peek",
        "tall",
        "full"
      ],
      "default": "peek"
    }
  },
  "slots": {
    "cta": {
      "max": 2
    },
    "alt": {
      "max": 1
    }
  },
  "requires": {
    "scroll": [
      "3d"
    ]
  },
  "recommends": {
    "3d": [
      "poster",
      "describe"
    ]
  },
  "themeReads": [
    "color.bg",
    "color.text",
    "color.muted",
    "color.accent",
    "color.accent-contrast",
    "color.scrim",
    "color.on-scrim",
    "space.*",
    "type.display",
    "type.body",
    "motion.*",
    "size.ring"
  ],
  "deps": {
    "three": "0.170.0",
    "@react-three/fiber": "8.17.10"
  },
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chrome-latest",
      "safari-latest",
      "firefox-latest",
      "ios-17"
    ],
    "with": [
      "nav",
      "footer"
    ]
  },
  "checks": [
    {
      "code": "AZ2120",
      "kind": "count",
      "severity": "error",
      "message": "{n} CTAs. Maximum is 2 (one primary, one secondary)",
      "slots": [
        "cta",
        "alt"
      ],
      "atLeast": 3
    },
    {
      "code": "AZ2121",
      "kind": "perPage",
      "severity": "error",
      "message": "only one per page (it owns the <h1>)",
      "atMost": 1
    },
    {
      "code": "AZ2122",
      "kind": "when",
      "severity": "warning",
      "message": "'full' fills the screen and hides the page below it — 'tall' keeps the peek that earns the scroll",
      "when": {
        "prop": "height",
        "value": "full"
      }
    }
  ]
}
