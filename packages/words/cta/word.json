{
  "name": "cta",
  "version": "1.0.0",
  "kind": "block",
  "description": "Closing call-to-action section before the footer",
  "descriptions": {
    "variants": {
      "band": "Full-bleed band in the inverted palette",
      "card": "Contained inset card on the page background",
      "split": "Text beside a supporting image"
    },
    "modifiers": {
      "glass": "Card blurs what is behind it; band stays solid",
      "reveal": "Rises into view once when scrolled to"
    }
  },
  "variants": [
    "band",
    "card",
    "split"
  ],
  "modifiers": [
    "glass",
    "reveal"
  ],
  "props": {
    "title": {
      "type": "string",
      "required": true,
      "maxWords": 12,
      "description": "Section heading (h2) stating the ask"
    },
    "sub": {
      "type": "string",
      "maxWords": 24,
      "description": "Line of text under the heading"
    },
    "media": {
      "type": "path",
      "ext": [
        ".jpg",
        ".png",
        ".webp",
        ".avif"
      ],
      "maxBytes": 512000,
      "description": "Image for split; resized at build to its column"
    },
    "describe": {
      "type": "string",
      "maxWords": 20,
      "description": "Alt text for media; omit if decorative"
    }
  },
  "slots": {
    "cta": {
      "max": 1,
      "description": "Primary button: label and destination"
    },
    "alt": {
      "max": 1,
      "description": "Secondary action beside the primary"
    }
  },
  "requires": {
    "split": [
      "media"
    ]
  },
  "themeReads": [
    "color.accent",
    "color.accent-contrast",
    "color.surface",
    "color.surface-alt",
    "color.text",
    "color.muted",
    "color.focus",
    "space.*",
    "radius.lg",
    "type.display",
    "type.body",
    "breakpoint.sm"
  ],
  "deps": {},
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2020",
      "kind": "count",
      "severity": "error",
      "message": "no action declared — add: cta \"Reserve a pair\" /reserve",
      "slots": [
        "cta"
      ],
      "atMost": 0
    },
    {
      "code": "AZ2021",
      "kind": "notFirst",
      "severity": "warning",
      "message": "this is the first block on the page — an opening statement is a 'hero'"
    },
    {
      "code": "AZ2022",
      "kind": "when",
      "severity": "warning",
      "message": "'glass' on 'band' blurs nothing — the band paints its own background",
      "when": {
        "variant": [
          "band"
        ],
        "modifier": "glass"
      }
    },
    {
      "code": "AZ2023",
      "kind": "perPage",
      "severity": "warning",
      "message": "{n} CTA blocks on one page — the ask stops being an ask",
      "atMost": 2
    },
    {
      "code": "AZ2024",
      "kind": "pageLacks",
      "severity": "warning",
      "message": "'glass' needs an image or scene behind it — on a flat background it does nothing",
      "when": {
        "modifier": "glass",
        "notVariant": [
          "band"
        ]
      },
      "needsWord": "scene",
      "needs": {
        "variant": [
          "backdrop"
        ]
      }
    }
  ]
}
