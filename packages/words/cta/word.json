{
  "name": "cta",
  "version": "1.0.0",
  "kind": "block",
  "variants": [
    "band",
    "card",
    "split"
  ],
  "modifiers": [
    "glass",
    "reveal"
  ],
  "props": {
    "title": {
      "type": "string",
      "required": true,
      "maxWords": 12
    },
    "sub": {
      "type": "string",
      "maxWords": 24
    },
    "media": {
      "type": "path",
      "ext": [
        ".jpg",
        ".png",
        ".webp",
        ".avif"
      ],
      "maxBytes": 512000
    },
    "describe": {
      "type": "string",
      "maxWords": 20
    }
  },
  "slots": {
    "cta": {
      "max": 1
    },
    "alt": {
      "max": 1
    }
  },
  "requires": {
    "split": [
      "media"
    ]
  },
  "themeReads": [
    "color.accent",
    "color.accent-contrast",
    "color.surface",
    "color.surface-alt",
    "color.text",
    "color.muted",
    "color.focus",
    "space.*",
    "radius.lg",
    "type.display",
    "type.body"
  ],
  "deps": {},
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2020",
      "kind": "count",
      "severity": "error",
      "message": "no action declared — add: cta \"Reserve a pair\" /reserve",
      "slots": [
        "cta"
      ],
      "atMost": 0
    },
    {
      "code": "AZ2021",
      "kind": "notFirst",
      "severity": "warning",
      "message": "this is the first block on the page — an opening statement is a 'hero'"
    },
    {
      "code": "AZ2022",
      "kind": "when",
      "severity": "warning",
      "message": "'glass' on 'band' blurs nothing — the band paints its own background",
      "when": {
        "variant": [
          "band"
        ],
        "modifier": "glass"
      }
    },
    {
      "code": "AZ2023",
      "kind": "perPage",
      "severity": "warning",
      "message": "{n} CTA blocks on one page — the ask stops being an ask",
      "atMost": 2
    }
  ]
}
