az 1

site aurora
  auth
    adapter azbackend
  backend
    database sqlite
    email    smtp
    model    default
  chat float
    title    "Ask Aurora"
    greeting "Hi! Ask me about sizes, shipping or repairs."
    ask      "How long does a pair take?"
    ask      "Do you resole?"

page /
  hero center
    title "Built in the dark"
    sub   "Shoes made by one maker, start to finish."
