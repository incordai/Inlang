{
  "name": "scene",
  "version": "1.0.0",
  "kind": "block",
  "variants": [
    "inline",
    "full",
    "backdrop",
    "none"
  ],
  "modifiers": [
    "3d",
    "scroll",
    "parallax"
  ],
  "props": {
    "model": {
      "type": "path",
      "ext": [
        ".glb"
      ],
      "maxBytes": 5242880
    },
    "poster": {
      "type": "path",
      "ext": [
        ".webp",
        ".jpg"
      ],
      "maxBytes": 262144,
      "required": true
    },
    "alt": {
      "type": "string",
      "required": true,
      "maxWords": 20
    },
    "ratio": {
      "type": "enum",
      "values": [
        "1:1",
        "4:3",
        "3:2",
        "16:9"
      ],
      "default": "4:3"
    },
    "caption": {
      "type": "string",
      "maxWords": 16
    },
    "camera": {
      "type": "enum",
      "values": [
        "fixed",
        "orbit",
        "scroll"
      ],
      "default": "fixed"
    }
  },
  "slots": {},
  "requires": {
    "3d": [
      "poster",
      "alt"
    ]
  },
  "themeReads": [
    "color.surface",
    "color.border",
    "space.*",
    "type.caption",
    "radius.md"
  ],
  "deps": {
    "three": "0.186.0"
  },
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2180",
      "kind": "when",
      "severity": "error",
      "message": "no renderer named — add: scene inline 3d",
      "when": {
        "notModifier": "3d",
        "notVariant": [
          "none"
        ]
      }
    },
    {
      "code": "AZ2181",
      "kind": "notFirst",
      "severity": "error",
      "message": "a scene cannot open a page — the LCP element must be text, use 'hero 3d'"
    },
    {
      "code": "AZ2182",
      "kind": "perPage",
      "severity": "error",
      "message": "{n} scenes on one page, maximum is 8 — split the page",
      "atMost": 8
    },
    {
      "code": "AZ2183",
      "kind": "perPage",
      "severity": "warning",
      "message": "{n} scenes on one page, budget is 4 — compress them or reuse one model",
      "atMost": 4
    },
    {
      "code": "AZ2184",
      "kind": "perPage",
      "severity": "warning",
      "message": "{n} full-bleed scenes compete for the same attention — make one 'inline'",
      "atMost": 1,
      "when": {
        "variant": [
          "full"
        ]
      }
    },
    {
      "code": "AZ2185",
      "kind": "when",
      "severity": "warning",
      "message": "'orbit' is drag-only for keyboard users — the emitter adds arrow-key control, check it reads sensibly",
      "when": {
        "prop": "camera",
        "value": "orbit"
      }
    }
  ]
}
