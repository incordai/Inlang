{
  "name": "scene",
  "version": "1.0.0",
  "kind": "block",
  "description": "Standalone 3D scene with a poster fallback",
  "descriptions": {
    "variants": {
      "inline": "Scene beside copy, capped at the text measure",
      "full": "Full-bleed scene that is the whole section",
      "backdrop": "Fixed 3D layer behind the page (site or page)",
      "none": "No backdrop on this page (page level)"
    },
    "modifiers": {
      "3d": "Renders the scene; required for every scene",
      "scroll": "Camera follows page scroll",
      "parallax": "Scene moves at half the scroll rate"
    }
  },
  "variants": [
    "inline",
    "full",
    "backdrop",
    "none"
  ],
  "modifiers": [
    "3d",
    "scroll",
    "parallax"
  ],
  "props": {
    "model": {
      "type": "path",
      "ext": [
        ".glb"
      ],
      "maxBytes": 5242880,
      "description": "Draco .glb model; else the procedural scene"
    },
    "poster": {
      "type": "path",
      "ext": [
        ".webp",
        ".jpg"
      ],
      "maxBytes": 262144,
      "required": true,
      "description": "Still image for static tier, loading, eviction"
    },
    "alt": {
      "type": "string",
      "required": true,
      "maxWords": 20,
      "description": "What the scene shows; read by screen readers"
    },
    "ratio": {
      "type": "enum",
      "values": [
        "1:1",
        "4:3",
        "3:2",
        "16:9"
      ],
      "default": "4:3",
      "description": "Aspect ratio of the scene box",
      "valueDescriptions": {
        "1:1": "Square box",
        "4:3": "4:3 box (default)",
        "3:2": "3:2 box",
        "16:9": "16:9 box"
      }
    },
    "caption": {
      "type": "string",
      "maxWords": 16,
      "description": "Visible caption under the scene"
    },
    "camera": {
      "type": "enum",
      "values": [
        "fixed",
        "orbit",
        "scroll"
      ],
      "default": "fixed",
      "description": "How the camera moves",
      "valueDescriptions": {
        "fixed": "Camera never moves (default)",
        "orbit": "Drag or arrow keys turn the object",
        "scroll": "Camera follows page scroll"
      }
    }
  },
  "slots": {},
  "requires": {
    "3d": [
      "poster",
      "alt"
    ]
  },
  "themeReads": [
    "color.bg",
    "color.focus",
    "color.muted",
    "color.surface-alt",
    "color.text",
    "layer.behind",
    "radius.md",
    "size.gutter-sm",
    "size.measure-body",
    "size.ring",
    "size.ring-offset",
    "space.12",
    "space.64",
    "type.size.xs"
  ],
  "deps": {
    "three": "0.186.1"
  },
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2180",
      "kind": "when",
      "severity": "error",
      "message": "no renderer named — add: scene inline 3d",
      "when": {
        "notModifier": "3d",
        "notVariant": [
          "none"
        ]
      }
    },
    {
      "code": "AZ2181",
      "kind": "notFirst",
      "severity": "error",
      "message": "a scene cannot open a page — the LCP element must be text, use 'hero 3d'"
    },
    {
      "code": "AZ2182",
      "kind": "perPage",
      "severity": "error",
      "message": "{n} scenes on one page, maximum is 8 — split the page",
      "atMost": 8
    },
    {
      "code": "AZ2183",
      "kind": "perPage",
      "severity": "warning",
      "message": "{n} scenes on one page, budget is 4 — compress them or reuse one model",
      "atMost": 4
    },
    {
      "code": "AZ2184",
      "kind": "perPage",
      "severity": "warning",
      "message": "{n} full-bleed scenes compete for the same attention — make one 'inline'",
      "atMost": 1,
      "when": {
        "variant": [
          "full"
        ]
      }
    },
    {
      "code": "AZ2185",
      "kind": "when",
      "severity": "warning",
      "message": "'orbit' is drag-only for keyboard users — the emitter adds arrow-key control, check it reads sensibly",
      "when": {
        "prop": "camera",
        "value": "orbit"
      }
    }
  ]
}
