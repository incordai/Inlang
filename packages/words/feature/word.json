{
  "name": "feature",
  "version": "1.0.0",
  "kind": "block",
  "description": "Set of features or benefits",
  "descriptions": {
    "variants": {
      "grid": "Equal-weight items in columns",
      "rows": "One item per row, media beside text",
      "bento": "Uneven tiles; the lead item gets the big tile"
    },
    "modifiers": {
      "reveal": "Fades in when scrolled into view (not rendered yet)"
    }
  },
  "variants": [
    "grid",
    "rows",
    "bento"
  ],
  "modifiers": [
    "reveal"
  ],
  "props": {
    "title": {
      "type": "string",
      "required": false,
      "maxWords": 10,
      "description": "Section heading (h2)"
    },
    "sub": {
      "type": "string",
      "required": false,
      "maxWords": 30,
      "description": "Line of text under the heading"
    },
    "columns": {
      "type": "int",
      "min": 2,
      "max": 4,
      "default": 3,
      "description": "Grid columns, 2 to 4 (grid variant only)"
    }
  },
  "slots": {
    "item": {
      "min": 2,
      "max": 12,
      "slots": {
        "link": {
          "max": 1,
          "description": "Link from the item to more detail"
        }
      },
      "props": {
        "title": {
          "type": "string",
          "required": true,
          "maxWords": 6,
          "description": "Item heading"
        },
        "text": {
          "type": "string",
          "maxWords": 40,
          "description": "Item description"
        },
        "icon": {
          "type": "path",
          "ext": [
            ".svg"
          ],
          "maxBytes": 16384,
          "description": "Decorative SVG icon, inlined and sanitised"
        },
        "media": {
          "type": "path",
          "maxBytes": 512000,
          "ext": [
            ".webp",
            ".jpg",
            ".png",
            ".avif"
          ],
          "description": "Screenshot or photo for the item"
        },
        "lead": {
          "type": "flag",
          "description": "Marks the item that outranks the rest (bento)"
        }
      },
      "description": "One feature: a label plus optional details"
    },
    "cta": {
      "max": 1,
      "description": "Primary button for the section"
    },
    "alt": {
      "max": 1,
      "description": "Secondary action beside the primary"
    }
  },
  "requires": {},
  "themeReads": [
    "color.text",
    "color.muted",
    "color.surface",
    "color.accent",
    "color.border",
    "color.focus",
    "space.*",
    "type.*",
    "radius.md",
    "motion.slow",
    "motion.reduced",
    "motion.ease.emphasis",
    "size.measure-display",
    "size.measure-body",
    "size.ring",
    "size.ring-offset",
    "breakpoint.sm"
  ],
  "deps": {},
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2060",
      "kind": "when",
      "severity": "warning",
      "message": "'columns' only applies to 'grid' — remove it or switch variant",
      "when": {
        "prop": "columns",
        "notVariant": [
          "grid"
        ]
      }
    },
    {
      "code": "AZ2061",
      "kind": "count",
      "severity": "error",
      "message": "{n} item — a feature section needs at least 2, or use 'text'",
      "slots": [
        "item"
      ],
      "atMost": 1
    },
    {
      "code": "AZ2062",
      "kind": "count",
      "severity": "error",
      "message": "'bento' needs 3–7 items, got {n} — use 'grid'",
      "slots": [
        "item"
      ],
      "atMost": 2,
      "when": {
        "variant": [
          "bento"
        ]
      }
    },
    {
      "code": "AZ2063",
      "kind": "count",
      "severity": "error",
      "message": "'bento' needs 3–7 items, got {n} — use 'grid'",
      "slots": [
        "item"
      ],
      "atLeast": 8,
      "when": {
        "variant": [
          "bento"
        ]
      }
    },
    {
      "code": "AZ2064",
      "kind": "childAtMostOne",
      "severity": "error",
      "message": "{n} items marked 'lead' — only one can lead",
      "slot": "item",
      "prop": "lead"
    },
    {
      "code": "AZ2065",
      "kind": "count",
      "severity": "warning",
      "message": "{n} rows is a long scroll — use 'grid', or cut to 3",
      "slots": [
        "item"
      ],
      "atLeast": 6,
      "when": {
        "variant": [
          "rows"
        ]
      }
    },
    {
      "code": "AZ2066",
      "kind": "childLabelWords",
      "severity": "warning",
      "message": "'{label}' is a sentence — item titles are 2–5 words",
      "slots": [
        "item"
      ],
      "atMost": 6
    },
    {
      "code": "AZ2067",
      "kind": "childMissing",
      "severity": "warning",
      "message": "'rows' gives each item half a screen — add 'text' or use 'grid'",
      "slot": "item",
      "prop": "text",
      "when": {
        "variant": [
          "rows"
        ]
      }
    },
    {
      "code": "AZ2068",
      "kind": "notFirst",
      "severity": "warning",
      "message": "'reveal' on the first block animates what is already on screen — drop it",
      "when": {
        "modifier": "reveal"
      }
    }
  ]
}
