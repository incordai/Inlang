{
  "name": "gallery",
  "version": "1.0.0",
  "kind": "block",
  "description": "Set of images in a chosen layout",
  "descriptions": {
    "variants": {
      "grid": "Uniform crops in columns",
      "masonry": "Uncropped mixed ratios in columns",
      "carousel": "Horizontal row that snaps slide by slide",
      "orbit": "3D ring of images; carousel on phones"
    },
    "modifiers": {
      "reveal": "Rises into view once, images staggered",
      "lightbox": "Images open full size in a viewer"
    }
  },
  "variants": [
    "grid",
    "masonry",
    "carousel",
    "orbit"
  ],
  "modifiers": [
    "reveal",
    "lightbox"
  ],
  "props": {
    "title": {
      "type": "string",
      "maxWords": 10,
      "description": "Section heading (h2)"
    },
    "sub": {
      "type": "string",
      "maxWords": 30,
      "description": "Line of text under the heading"
    },
    "columns": {
      "type": "int",
      "min": 2,
      "max": 4,
      "default": 3,
      "description": "Grid columns, 2 to 4 (grid variant only)"
    },
    "ratio": {
      "type": "enum",
      "default": "3:2",
      "values": [
        "square",
        "4:3",
        "3:2",
        "16:9",
        "portrait",
        "auto"
      ],
      "description": "Crop ratio for every image",
      "valueDescriptions": {
        "square": "1:1 crop",
        "4:3": "4:3 crop",
        "3:2": "3:2 crop (the default)",
        "16:9": "16:9 crop",
        "portrait": "4:5 portrait crop",
        "auto": "No crop; each image keeps its own shape"
      }
    },
    "poster": {
      "type": "path",
      "ext": [
        ".webp",
        ".jpg"
      ],
      "maxBytes": 262144,
      "description": "Still image for orbit before or without 3D"
    }
  },
  "slots": {
    "image": {
      "min": 2,
      "max": 200,
      "props": {
        "src": {
          "type": "path",
          "required": true,
          "maxBytes": 512000,
          "ext": [
            ".webp",
            ".jpg",
            ".png",
            ".avif"
          ],
          "description": "Image file path"
        },
        "alt": {
          "type": "string",
          "required": true,
          "description": "What the image shows; \"\" if the caption says it"
        },
        "caption": {
          "type": "string",
          "maxWords": 12,
          "description": "Visible caption under the image"
        },
        "focus": {
          "type": "enum",
          "default": "center",
          "values": [
            "center",
            "top",
            "bottom",
            "left",
            "right"
          ],
          "description": "Which part to keep when cropping",
          "valueDescriptions": {
            "center": "Keep the centre (default)",
            "top": "Keep the top edge",
            "bottom": "Keep the bottom edge",
            "left": "Keep the left edge",
            "right": "Keep the right edge"
          }
        }
      },
      "description": "One image; its first value is the file path"
    },
    "cta": {
      "max": 1,
      "description": "Primary button for the section"
    },
    "alt": {
      "max": 1,
      "description": "Secondary action beside the primary"
    }
  },
  "requires": {
    "orbit": [
      "poster"
    ]
  },
  "themeReads": [
    "color.text",
    "color.muted",
    "color.surface",
    "color.focus",
    "color.scrim",
    "color.on-scrim",
    "color.overlay",
    "space.*",
    "type.*",
    "radius.md",
    "motion.emphasis",
    "motion.backdrop",
    "motion.fast",
    "motion.reduced",
    "motion.ease.emphasis",
    "layer.modal",
    "layer.backdrop",
    "size.measure-display",
    "size.measure-body",
    "size.tap",
    "size.ring",
    "size.ring-offset",
    "breakpoint.sm"
  ],
  "deps": {
    "three": "0.186.0"
  },
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2100",
      "kind": "count",
      "severity": "error",
      "message": "no images — add: image ./photo.webp",
      "slots": [
        "image"
      ],
      "atMost": 0
    },
    {
      "code": "AZ2101",
      "kind": "count",
      "severity": "error",
      "message": "1 image is not a gallery — use 'feature' or a hero",
      "slots": [
        "image"
      ],
      "atLeast": 1,
      "atMost": 1
    },
    {
      "code": "AZ2102",
      "kind": "count",
      "severity": "warning",
      "message": "{n} images means {n} tab stops before the footer — split it or use 'carousel'",
      "slots": [
        "image"
      ],
      "atLeast": 61,
      "atMost": 200
    },
    {
      "code": "AZ2103",
      "kind": "count",
      "severity": "error",
      "message": "{n} images is an archive, not a section — paginate it with 'content'",
      "slots": [
        "image"
      ],
      "atLeast": 201
    },
    {
      "code": "AZ2104",
      "kind": "count",
      "severity": "error",
      "message": "'orbit' caps at 16 images, got {n} — use 'grid', or cut the set",
      "slots": [
        "image"
      ],
      "atLeast": 17,
      "when": {
        "variant": [
          "orbit"
        ]
      }
    },
    {
      "code": "AZ2105",
      "kind": "count",
      "severity": "error",
      "message": "'orbit' needs at least 4 images to read as a ring — use 'grid'",
      "slots": [
        "image"
      ],
      "atMost": 3,
      "when": {
        "variant": [
          "orbit"
        ]
      }
    },
    {
      "code": "AZ2106",
      "kind": "childMissing",
      "severity": "warning",
      "message": "'{label}' has no alt text — add: alt \"what it shows\", or alt \"\" if the caption says it",
      "slot": "image",
      "prop": "alt"
    },
    {
      "code": "AZ2107",
      "kind": "childEqual",
      "severity": "warning",
      "message": "alt and caption are identical on '{label}' — set alt \"\" so it isn't read twice",
      "slot": "image",
      "props": [
        "alt",
        "caption"
      ]
    },
    {
      "code": "AZ2108",
      "kind": "childAllOrNone",
      "severity": "warning",
      "message": "{k} of {n} images have captions — caption all of them or none",
      "slot": "image",
      "prop": "caption"
    },
    {
      "code": "AZ2109",
      "kind": "when",
      "severity": "warning",
      "message": "'columns' only applies to 'grid' — remove it or switch variant",
      "when": {
        "prop": "columns",
        "notVariant": [
          "grid"
        ]
      }
    },
    {
      "code": "AZ2110",
      "kind": "when",
      "severity": "warning",
      "message": "'ratio auto' leaves ragged rows in 'grid' — set a ratio, or use 'masonry'",
      "when": {
        "variant": [
          "grid"
        ],
        "prop": "ratio",
        "value": "auto"
      }
    },
    {
      "code": "AZ2111",
      "kind": "when",
      "severity": "warning",
      "message": "'orbit' opens its own viewer — 'lightbox' has no effect",
      "when": {
        "variant": [
          "orbit"
        ],
        "modifier": "lightbox"
      }
    },
    {
      "code": "AZ2112",
      "kind": "count",
      "severity": "warning",
      "message": "{n} images fit on one screen — 'carousel' hides two of them for nothing",
      "slots": [
        "image"
      ],
      "atLeast": 1,
      "atMost": 3,
      "when": {
        "variant": [
          "carousel"
        ]
      }
    },
    {
      "code": "AZ2113",
      "kind": "perPage",
      "severity": "error",
      "message": "{n} orbit scenes on one page — one WebGL context per page",
      "atMost": 1,
      "when": {
        "variant": [
          "orbit"
        ]
      }
    }
  ]
}
