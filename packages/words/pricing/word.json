{
  "name": "pricing",
  "version": "1.0.0",
  "kind": "block",
  "description": "Plans and prices with a monthly/annual toggle",
  "descriptions": {
    "variants": {
      "cards": "One card per plan, compared by degree",
      "table": "Comparison table; per-plan panels on phones"
    },
    "modifiers": {
      "reveal": "Fades in when scrolled into view"
    }
  },
  "variants": [
    "cards",
    "table"
  ],
  "modifiers": [
    "reveal"
  ],
  "props": {
    "title": {
      "type": "string",
      "required": true,
      "maxWords": 8,
      "description": "Section heading (h2)"
    },
    "sub": {
      "type": "string",
      "maxWords": 24,
      "description": "Line of text under the heading"
    },
    "currency": {
      "type": "enum",
      "values": "iso4217",
      "description": "ISO 4217 currency code for every price"
    },
    "locale": {
      "type": "string",
      "default": "en-US",
      "description": "Locale used to format prices, e.g. en-US"
    },
    "billing": {
      "type": "enum",
      "values": [
        "monthly",
        "annual"
      ],
      "default": "monthly",
      "description": "Billing period shown first",
      "valueDescriptions": {
        "monthly": "Show monthly prices first (default)",
        "annual": "Show annual prices first"
      }
    },
    "period": {
      "type": "string",
      "maxWords": 6,
      "description": "Price suffix, e.g. per seat, per month"
    }
  },
  "slots": {
    "plan": {
      "min": 1,
      "max": 4,
      "props": {
        "monthly": {
          "type": "string",
          "required": true,
          "description": "Price per month"
        },
        "annual": {
          "type": "string",
          "description": "Price per year; set on every plan or none"
        },
        "highlight": {
          "type": "enum",
          "values": [
            "on",
            "off"
          ],
          "default": "off",
          "description": "Mark as the recommended plan",
          "valueDescriptions": {
            "on": "Accent border, moved first on phones",
            "off": "Normal plan (default)"
          }
        },
        "badge": {
          "type": "string",
          "maxWords": 4,
          "description": "Short label on the plan, e.g. Most popular"
        }
      },
      "slots": {
        "feature": {
          "max": 24,
          "description": "Feature line: label and value or yes"
        },
        "cta": {
          "min": 1,
          "max": 1,
          "description": "The plan's button"
        }
      },
      "description": "One plan; its label is the plan name"
    }
  },
  "requires": {},
  "themeReads": [
    "color.accent",
    "color.accent-contrast",
    "color.surface",
    "color.surface-alt",
    "color.text",
    "color.muted",
    "color.border",
    "color.focus",
    "space.*",
    "radius.md",
    "radius.lg",
    "type.body"
  ],
  "deps": {},
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2160",
      "kind": "count",
      "severity": "error",
      "message": "no plans declared — add: plan \"Studio\"",
      "slots": [
        "plan"
      ],
      "atMost": 0
    },
    {
      "code": "AZ2161",
      "kind": "childAtMostOne",
      "severity": "error",
      "message": "'{first}' and '{second}' are both highlighted — highlight one",
      "slot": "plan",
      "prop": "highlight",
      "value": "on"
    },
    {
      "code": "AZ2162",
      "kind": "childAllOrNone",
      "severity": "error",
      "message": "'{with}' has an annual price and '{without}' does not — declare annual on every plan or none",
      "slot": "plan",
      "prop": "annual"
    },
    {
      "code": "AZ2163",
      "kind": "valuePattern",
      "severity": "error",
      "message": "'{prop} {value}' is an expression — declare the number",
      "slot": "plan",
      "prop": "monthly",
      "pattern": "[*/+×=]"
    },
    {
      "code": "AZ2164",
      "kind": "valuePattern",
      "severity": "error",
      "message": "'{prop} {value}' is an expression — declare the number",
      "slot": "plan",
      "prop": "annual",
      "pattern": "[*/+×=]"
    },
    {
      "code": "AZ2165",
      "kind": "count",
      "severity": "error",
      "message": "'billing annual' but no plan declares one — add: annual 290",
      "slots": [
        "plan"
      ],
      "prop": "annual",
      "atMost": 0,
      "when": {
        "prop": "billing",
        "value": "annual"
      }
    },
    {
      "code": "AZ2166",
      "kind": "count",
      "severity": "warning",
      "message": "{n} plans, 4 is the practical maximum — merge two or move the detail into 'table'",
      "slots": [
        "plan"
      ],
      "atLeast": 5
    }
  ]
}
