{
  "name": "pricing",
  "version": "1.0.0",
  "kind": "block",
  "variants": [
    "cards",
    "table"
  ],
  "modifiers": [
    "reveal"
  ],
  "props": {
    "title": {
      "type": "string",
      "required": true,
      "maxWords": 8
    },
    "sub": {
      "type": "string",
      "maxWords": 24
    },
    "currency": {
      "type": "enum",
      "values": "iso4217"
    },
    "locale": {
      "type": "string",
      "default": "en-US"
    },
    "billing": {
      "type": "enum",
      "values": [
        "monthly",
        "annual"
      ],
      "default": "monthly"
    },
    "period": {
      "type": "string",
      "maxWords": 6
    }
  },
  "slots": {
    "plan": {
      "min": 1,
      "max": 4,
      "props": {
        "monthly": {
          "type": "string",
          "required": true
        },
        "annual": {
          "type": "string"
        },
        "highlight": {
          "type": "enum",
          "values": [
            "on",
            "off"
          ],
          "default": "off"
        },
        "badge": {
          "type": "string",
          "maxWords": 4
        }
      },
      "slots": {
        "feature": {
          "max": 24
        },
        "cta": {
          "min": 1,
          "max": 1
        }
      }
    }
  },
  "requires": {},
  "themeReads": [
    "color.accent",
    "color.accent-contrast",
    "color.surface",
    "color.surface-alt",
    "color.text",
    "color.muted",
    "color.border",
    "color.focus",
    "space.*",
    "radius.md",
    "radius.lg",
    "type.body"
  ],
  "deps": {},
  "targets": [
    "web"
  ],
  "tested": {
    "browsers": [
      "chromium-153",
      "firefox-155",
      "webkit-26.6"
    ],
    "with": [
      "hero"
    ]
  },
  "checks": [
    {
      "code": "AZ2160",
      "kind": "count",
      "severity": "error",
      "message": "no plans declared — add: plan \"Studio\"",
      "slots": [
        "plan"
      ],
      "atMost": 0
    },
    {
      "code": "AZ2161",
      "kind": "childAtMostOne",
      "severity": "error",
      "message": "'{first}' and '{second}' are both highlighted — highlight one",
      "slot": "plan",
      "prop": "highlight",
      "value": "on"
    },
    {
      "code": "AZ2162",
      "kind": "childAllOrNone",
      "severity": "error",
      "message": "'{with}' has an annual price and '{without}' does not — declare annual on every plan or none",
      "slot": "plan",
      "prop": "annual"
    },
    {
      "code": "AZ2163",
      "kind": "valuePattern",
      "severity": "error",
      "message": "'{prop} {value}' is an expression — declare the number",
      "slot": "plan",
      "prop": "monthly",
      "pattern": "[*/+×=]"
    },
    {
      "code": "AZ2164",
      "kind": "valuePattern",
      "severity": "error",
      "message": "'{prop} {value}' is an expression — declare the number",
      "slot": "plan",
      "prop": "annual",
      "pattern": "[*/+×=]"
    },
    {
      "code": "AZ2165",
      "kind": "count",
      "severity": "error",
      "message": "'billing annual' but no plan declares one — add: annual 290",
      "slots": [
        "plan"
      ],
      "prop": "annual",
      "atMost": 0,
      "when": {
        "prop": "billing",
        "value": "annual"
      }
    },
    {
      "code": "AZ2166",
      "kind": "count",
      "severity": "warning",
      "message": "{n} plans, 4 is the practical maximum — merge two or move the detail into 'table'",
      "slots": [
        "plan"
      ],
      "atLeast": 5
    }
  ]
}
