{
  "name": "az-spike-m0",
  "private": true,
  "type": "module",
  "description": "M0 spike \u2014 one hand-built hero, three motion tiers, runtime tier probe. No compiler, no abstraction. See docs/ROADMAP.md M0.",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test:determinism": "node --experimental-strip-types scripts/determinism.ts",
    "test:engines": "node --experimental-strip-types scripts/cross-engine.ts",
    "test:probe": "node --experimental-strip-types scripts/probe.test.ts",
    "test:decision": "node --experimental-strip-types scripts/decision.test.ts",
    "test:m0": "node --experimental-strip-types scripts/m0.test.ts",
    "test:browser": "node --experimental-strip-types scripts/browser.test.ts",
    "shoot": "node --experimental-strip-types scripts/shoot.ts",
    "seams": "node --experimental-strip-types scripts/seams.ts",
    "test:fade": "node --experimental-strip-types scripts/fade.test.ts",
    "extract:palette": "node --experimental-strip-types scripts/extract-palette.ts",
    "test:layout": "node --experimental-strip-types scripts/layout.test.ts",
    "verify": "pnpm build && pnpm test:determinism && pnpm test:probe && pnpm test:decision && pnpm test:shades && pnpm test:patterns && pnpm test:layout && pnpm test:browser && pnpm test:fade && pnpm seams",
    "test:shades": "node --experimental-strip-types scripts/shades.test.ts",
    "matrix": "node --experimental-strip-types scripts/matrix.ts",
    "test:patterns": "node --experimental-strip-types scripts/patterns.test.ts"
  },
  "dependencies": {
    "@react-three/drei": "10.7.8",
    "@react-three/fiber": "9.7.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "three": "0.185.1"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pngjs": "6.0.5",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@types/three": "0.185.4",
    "@vitejs/plugin-react": "6.1.0",
    "playwright": "1.62.1",
    "pngjs": "7.0.0",
    "typescript": "7.0.2",
    "vite": "8.2.2"
  }
}
