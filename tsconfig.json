{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "erasableSyntaxOnly": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["packages/*/src", "packages/*/test"],
  "exclude": ["packages/*/test/fixture-assets", "packages/overlay/src/runtime/behaviours.ts", "packages/auth-runtime/src/runtime/form.ts", "packages/scene-runtime/src/runtime/gate.ts", "packages/scene-runtime/src/runtime/colours.ts", "packages/scene-runtime/src/runtime/stage.ts", "packages/scene-runtime/src/runtime/index.ts"]
}
