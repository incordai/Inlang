az 1

# The chat prompt budget's large fixture (docs/token-benchmark.md §8, chat-block-spec §19.17): a shop
# of 40 pages whose chat shows faq, cta and feature, past the size where every page is sent in full.

site bench
  description "Bench makes small lamps by hand."
  backend
    database sqlite
    model    default
  chat float
    title    "Ask about Bench"
    greeting "Ask me about the lamps."
    show     faq cta feature
    allow    anyone

page /
  hero center
    title "Bench lamps"
    sub   "Small lamps, built by hand."
    cta   "See the lamps" /lamps

page /lamps
  feature
    title "Every lamp"
    item "Desk lamp"
      text "A brass desk lamp with a weighted base and a hinged arm."
    item "Floor lamp"
      text "A tall floor lamp in walnut for reading corners."
    item "Pendant lamp"
      text "A ceramic pendant for kitchens and dining tables."
    item "Wall lamp"
      text "A swing-arm wall lamp for bedsides and hallways."
    item "Clip lamp"
      text "A small clip lamp for shelves, bunks and easels."
    item "Table lamp"
      text "A stoneware table lamp with a pleated shade."
    item "Lantern"
      text "A rechargeable lantern for gardens and camping."
    item "Light strip"
      text "A dimmable light strip for shelves and cabinets."
    item "Filament bulb"
      text "A warm filament bulb that fits every Bench lamp."
    item "Spare shades"
      text "Linen, paper and pleated shades sold on their own."
    item "Night light"
      text "A soft night light for children's rooms with a timer."
    item "Studio light"
      text "A bright studio light for drawing and craft work."

